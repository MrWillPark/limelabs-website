{
  "buildCommand": null,
  "outputDirectory": ".",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in cursor/*) echo \"Skipping agent branch: $VERCEL_GIT_COMMIT_REF\"; exit 0;; *) echo \"Building branch: $VERCEL_GIT_COMMIT_REF\"; exit 1;; esac",
  "redirects": [
    {
      "source": "/matchaplanner",
      "destination": "/matchaplanner/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/matchaplanner/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/partners/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/(.*one-pager.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/(katsura-garden|moss-and-spade|memory-plants|bggh)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ]
}
